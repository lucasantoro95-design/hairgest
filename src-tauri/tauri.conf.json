{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HairGest",
  "version": "1.0.6",
  "identifier": "com.glamhair.hairgest",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "HairGest - Gestionale Salone",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:hairgest.db"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyNDlFOTY1NzUzNzY1QkYKUldTL1pUZDFaZWxKQWlXY3g1eGZkTUNtMUF6U09QNDIyOVRLeXFoVzNoZFgvYzVVKzRWNWlUdDkK",
      "endpoints": [
        "https://github.com/lucasantoro95-design/hairgest/releases/latest/download/latest.json"
      ]
    }
  }
}
